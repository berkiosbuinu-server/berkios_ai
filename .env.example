BERKIOS_ENV=production

POSTGRES_USER=berkios
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=berkios

# AI provider keys are injected at runtime and should not be committed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Public API hostname used by your reverse proxy.
BERKIOS_API_DOMAIN=api.example.com
